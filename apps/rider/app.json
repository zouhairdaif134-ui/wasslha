{
  "expo": {
    "name": "WASSLHA Rider",
    "slug": "wasslha-rider",
    "owner": "wasslhas-team",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "wasslha-rider",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WASSLHA يحتاج موقعك أثناء الخدمة باش يوصل ليك الطلبات ويتتبع التوصيل.",
          "locationAlwaysAndWhenInUsePermission": "WASSLHA يحتاج موقعك حتى فاش التطبيق مسدود، باش الزبون يتبع التوصيل.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E53935",
          "defaultChannel": "wasslha-offers"
        }
      ],
      "./plugins/with-android-build-fixes"
    ],
    "android": {
      "package": "ma.wasslha.rider",
      "versionCode": 3,
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "298369d2-c818-4bb3-ab0b-706f7885a9e9"
      }
    }
  }
}
